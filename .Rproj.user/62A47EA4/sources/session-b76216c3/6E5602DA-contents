GET THE TPMs matrixes for sce and bulk datasets #make the TPMS of bulk data

```{r}
#Bulk 
rownames(dds) <- rowData(dds)$gene_name
bulk.mtx <- counts(dds)
length(rownames(bulk.mtx)) # 24791

rownames(bulk.mtx)[duplicated(rownames(bulk.mtx))] 
bulk.mtx <- bulk.mtx[!duplicated(rownames(bulk.mtx)), ]
length(rownames(bulk.mtx)) # 24670

matching_idx <- match(rownames(bulk.mtx), gene.leng$gene_name) #24670
bulk.vector <- gene.leng[matching_idx, c(1, 2,3)] #24670

#Be sure that genes in bulk.vector are in same order than genes in bulk.mtx
bulk.vector <- bulk.vector %>%
  mutate(gene_name = factor(gene_name, levels = rownames(bulk.mtx))) %>%
  arrange(gene_name)

bulk.vector <- bulk.vector$Length
bulk.tpm <- get_TPM( counts = bulk.mtx, effLen = bulk.vector)


### single cell data
length(rownames(matrix)) #23616
#common <- intersect(rownames(matrix), rownames(bulk.mtx)) #23616

matching_idx <- match(rownames(matrix), gene.leng$gene_name)
sce.vector <- gene.leng[matching_idx, c(1, 2,3)] #24670

#Be sure that genes in vector are in same order than genes in matrix
sce.vector <- sce.vector %>%
  mutate(gene_name = factor(gene_name, levels = rownames(matrix))) %>%
  arrange(gene_name)

sce.vector <- sce.vector$Length
sce.tpm <- get_TPM(counts = matrix, effLen = sce.vector)

```

