```{r}
#Load bulk data
load("~/Desktop/HIV/July25/filt_dds_env.rda")
dds
bulk.meta <- as.data.frame(dds@colData)

#get count matrix
bulk.mtx <- counts(dds)

all(colnames(bulk.mtx) == rownames(bulk.meta))  #TRUE
by_tissue <- split(seq_along(colnames(bulk.mtx)), bulk.meta$tissue)


counts_by_tissue <- sapply(by_tissue, function(idx) {
  rowSums(bulk.mtx[, idx, drop = FALSE])
})

#Load info about gene lenght
gene.leng <- read.table("~/Desktop/HIV/Granulator/TPM/2033-CSF-Lym.tsv", header = TRUE, comment.char = "#", stringsAsFactors = FALSE)
gene.leng <- gene.leng[, c("Geneid",  "Length")]

#NOTE THAT IS IN ENSEMBL but we have the names in the genes object loaded with dds
#Add the symbol info
gene.leng <- merge(gene.leng, genes, by.x = "Geneid", by.y = "gene_id", all.x = TRUE)

```

# Prepare the data

```{r}
#bulk
length(rownames(counts_by_tissue)) #24791



library(Matrix)
TidyDat <- JoinLayers(TidyDat, assay = "RNA")

#Convert to single cell experiment
hayes.sce <- as.SingleCellExperiment(TidyDat, assay = "RNA")
hayes.sce <- aggregateData(hayes.sce, assay = "counts", by = c("atlas_labels" )) #output is a single cell experiment, so get the matrix

sce.mtx <- assay(hayes.sce)
sce.mtx <- as.matrix(sce.mtx)
sce.genes <- rownames(sce.mtx) #36,606

##### 
length(rownames(counts_by_tissue)) # 24791
length(rownames(sce.mtx)) #36,606

#So far the bulk vector lenght is 24791 while single cell is 36,606
#Get only the common genes
common <- intersect(rownames(counts_by_tissue), rownames(sce.mtx)) #15722

#filter sce
sce.mtx <- sce.mtx[rownames(sce.mtx) %in% common, , drop = FALSE]
#filter bulk
counts_by_tissue<- counts_by_tissue[rownames(counts_by_tissue) %in% rownames(sce.mtx), , drop = FALSE]


length(rownames(counts_by_tissue)) # 15729
length(rownames(sce.mtx)) #15722

#make bulk vector 
matching_idx <- match(rownames(counts_by_tissue), gene.leng$gene_name) #15729
bulk.vector <- gene.leng[matching_idx, c(1, 2,3)] #15729

#There are some duplicated genes
dup_genes <- rownames(counts_by_tissue)[duplicated(rownames(counts_by_tissue))]
length(dup_genes)        
head(dup_genes) 
counts_by_tissue <- counts_by_tissue[!duplicated(rownames(counts_by_tissue)), ]

length(rownames(counts_by_tissue)) # 15722

#RE DO make bulk vector 
matching_idx <- match(rownames(counts_by_tissue), gene.leng$gene_name) #15722
bulk.vector <- gene.leng[matching_idx, c(1, 2,3)] #15722


#make single cell vector
matching_idx_sc <- match(rownames(sce.mtx), gene.leng$gene_name)#15722
sce.vector <- gene.leng[matching_idx_sc, c(1, 2,3)]#15722


#Be sure that genes in BULK vector and matrix are in same order
bulk.vector <- bulk.vector %>%
  mutate(gene_name = factor(gene_name, levels = rownames(counts_by_tissue))) %>%
  arrange(gene_name)

#be super sure
sure_dfBulk <- data.frame(
  b.vec = bulk.vector$gene_name,
  matx = rownames(counts_by_tissue))


#Be sure that genes in single cell vector and matrix are in same order
sce.vector <- sce.vector %>%
  mutate(gene_name = factor(gene_name, levels = rownames(sce.mtx))) %>%
  arrange(gene_name)

#be super sure
sure_dfSC <- data.frame(
  b.vec = sce.vector$gene_name,
  matx = rownames(sce.mtx))

#Get the TPMs

bulk.vector <- bulk.vector$Length
bulk.tpm <- get_TPM( counts = counts_by_tissue, effLen = bulk.vector)

sce.vector <- sce.vector$Length
sce.tpm <- get_TPM(counts = sce.mtx, effLen = sce.vector)


```

