## Prepare dataframes and master map

### 

```{r}
library(dplyr)
library(ggplot2)
library(tidyr)
library(SingleCellExperiment)
library(Seurat)
library(biomaRt)
library(cowplot)
library(granulator)
library(tximport)
library(zellkonverter)
```

```{r}
#Load bulk data
load("~/Desktop/HIV/July25/filt_dds_env.rda") #This loads different objects including dds, res, samples, genes
#Filter myeloid
bulk.meta <- as.data.frame(dds@colData)
keep <- rownames(bulk.meta)[bulk.meta$cell %in% "myeloid"]
dds <- dds [, keep]

#rownames(dds) <- rowData(dds)$gene_name
#rownames(bulk.mtx) <- genes$gene_name

#get count matrix
bulk.mtx <- counts(dds)


all(colnames(bulk.mtx) == rownames(bulk.meta))  #TRUE
by_tissue <- split(seq_along(colnames(bulk.mtx)), bulk.meta$tissue)


counts_by_tissue <- sapply(by_tissue, function(idx) {
  rowSums(bulk.mtx[, idx, drop = FALSE])
})


#Get the genes present in our dds object and get the length
genes <- as.data.frame(rowData(dds)[, 1:2])

#Load gene lenght info
leng <- read.table("~/Desktop/HIV/Granulator/TPM/2033-CSF-Mye.tsv", header = TRUE, comment.char = "#", stringsAsFactors = FALSE)
head(leng) #Notice that Geneid is in Ensambl 
leng <- leng[, c("Geneid",  "Length")]

#Make a map with the genes in our bulk object and the lenght 
master_map <- as.data.frame(merge(genes, leng, by.x = "gene_id", by.y = "Geneid", all.x = TRUE))
```

## Make gene length vector

```{r}

#Get the lenght of the genes present in the myeloid bulk fraction from the master map 
#bulk.vector <- master_map[master_map$gene_id %in% genes$gene_id, c("gene_id", "gene_name", "Length")]


#Make sure that the gene names in the vector are in the same order than the count matrix
bulk.vector <- master_map %>%
  mutate(gene_id = factor(gene_id, levels = rownames(counts_by_tissue))) %>%
  arrange(gene_id)

#extra sure, just to visually check
sure_df <- data.frame(
  b.vec = bulk.vector$gene_id,
  matx = rownames(counts_by_tissue))

#now we are sure they are in the same order
bulk.vector <- bulk.vector$Length

#get TPM
bulk.tpm <- get_TPM( counts = counts_by_tissue, effLen = bulk.vector)
```

