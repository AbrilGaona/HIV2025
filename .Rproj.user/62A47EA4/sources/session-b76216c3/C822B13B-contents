### Perform pseudo bulk

```{r}
sce.myeloid <- readH5AD("~/Desktop/HIV/Granulator/myeloid_raw_counts.h5ad")

#PSEUDO BULK
library(muscat) 

names(colData(sce.myeloid))
assayNames(sce.myeloid) # "X"

sce <- aggregateData(sce.myeloid, assay = "X", by = c("cell_type" )) #output is a single cell experiment, so get the matrix
sce.mtx <- assay(sce)
sce.mtx <- as.matrix(sce.mtx)
sce.genes <- rownames(sce.mtx) #64394
sce.genes <- data.frame(gene_id = sce.genes) #sce genes are in "vernacular" and the lenghts are only available in ensmbl

genes <- as.data.frame(rowData(dds)[,1:2])
rownames(counts_by_tissue) <- genes$gene_name

#Keep only the genes that are common between bulk and sce
common <- intersect(sce.genes$gene_id, rownames(counts_by_tissue)) 
length(common) #23616
length(rownames(sce.mtx)) # 64394

#Filter
sce.mtx <- sce.mtx[rownames(sce.mtx) %in% common, , drop = FALSE]
sce.genes <- rownames(sce.mtx)
length(rownames(sce.mtx)) #23616
length(sce.genes) #23616
sce.genes <- data.frame(gene_id = sce.genes)


sce.vector <- master_map[master_map$gene_name %in% rownames(sce.mtx), c(2,3) ]
length(sce.vector$gene_name) #23629

matching_idx <- match(rownames(sce.mtx), sce.vector$gene_name)
sce.vector <- sce.vector[matching_idx, c(1,2)]
length(rownames(sce.mtx)) #23616
length(sce.vector$gene_name) #23616

#common_genes <- intersect(rownames(sce.mtx), sce.genes$gene_id)
#length(common_genes)
#sce.mtx <- sce.mtx[common_genes, , drop=FALSE]

#sce.genes <- sce.genes[match(rownames(sce.mtx), sce.genes$gene_id), , drop=FALSE]
identical(rownames(sce.mtx), sce.vector$gene_name)  #TRUE
all(sce.vector$gene_name == rownames(sce.mtx)) #TRUE


#now we are sure they are in the same order
sce.vector <- sce.vector$Length

#get TPM
sce.tpm <- get_TPM( counts = sce.mtx, effLen = sce.vector)

#CORRI DECON Y SALIO QUE LOS NOMBRES ERAN DIFERENTES SU PUTA MADRE!
