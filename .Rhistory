make_centered_html <- function(img_files, folder = "../figs") {
for (img in img_files) {
# output filename
out_file <- sub("\\.jpg$|\\.png$|\\.jpeg$", "_cntrd.html", img, ignore.case = TRUE)
out_path <- file.path(folder, out_file)
# build html
html_code <- sprintf('
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>%s</title>
<style>
body {
margin: 0;
background: #fff;
display: flex;
justify-content: center;
align-items: center;
height: 100vh;
}
img {
max-width: 95%%;
max-height: 95%%;
}
</style>
</head>
<body>
<img src="%s" alt="%s">
</body>
</html>
', img, img, img)
# write the file
writeLines(html_code, out_path)
message("Created: ", out_path)
}
}
imgs <- list.files("../figs", pattern = "\\.jpg$", full.names = FALSE)
imgs <- list.files("~/Desktop/HIV2025/figs", pattern = "\\.jpg$", full.names = FALSE)
make_centered_html(imgs, folder = "~/Desktop/HIV2025/figs")
