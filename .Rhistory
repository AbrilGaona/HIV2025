make_one_centered_html <- function(img_file, folder = "../figs") {
# output filename
out_file <- sub("\\.jpg$|\\.png$|\\.jpeg$", "_centered.html", img_file, ignore.case = TRUE)
out_path <- file.path(folder, out_file)
# build html
html_code <- sprintf('
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>%s</title>
<style>
body {
margin: 0;
background: #fff;
display: flex;
justify-content: center;
align-items: center;
height: 100vh;
}
img {
max-width: 95%%;
max-height: 95%%;
}
</style>
</head>
<body>
<img src="%s" alt="%s">
</body>
</html>
', img_file, img_file, img_file)
# write the file
writeLines(html_code, out_path)
message("Created: ", out_path)
}
make_one_centered_html("F5_H.jpg")
