make_one <- function(img_file, folder = "~/Desktop/HIV2025/figs") {
# Create output HTML filename
out_file <- sub("\\.(jpg|jpeg|png)$", "_cntrd.html", img_file, ignore.case = TRUE)
out_path <- file.path(folder, out_file)
html_code <- sprintf('
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>%s</title>
<style>
body {
margin: 0;
background: #fff;
display: flex;
justify-content: center;
align-items: center;
height: 100vh;
}
img {
max-width: 95%%;
max-height: 95%%;
}
</style>
</head>
<body>
<img src="%s" alt="%s">
</body>
</html>
', img_file, img_file, img_file)
# Write the HTML file
writeLines(html_code, out_path)
message("Created centered HTML: ", out_path)
}
